<?xml version="1.0" encoding="utf-8" ?>

<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="AlertaPulsera.MainPage"
    Title="AlertaPulsera">

    <ScrollView>

        <VerticalStackLayout
            Padding="20"
            Spacing="15">

            <Label
                Text="AlertaPulsera"
                FontSize="28"
                FontAttributes="Bold"
                HorizontalOptions="Center" />

            <!-- PULSOS -->

            <Label
                Text="Frecuencia cardíaca"
                FontSize="20"
                FontAttributes="Bold" />

            <Label
                x:Name="PulsosLabel"
                Text="-- BPM"
                FontSize="42"
                HorizontalOptions="Center" />

            <Label
                x:Name="EstadoPulsosLabel"
                Text="Esperando lectura de la pulsera..."
                FontSize="14"
                HorizontalTextAlignment="Center" />

            <BoxView
                HeightRequest="1"
                Color="Gray" />

            <!-- NOTIFICACIONES -->

            <Label
                Text="Notificaciones"
                FontSize="20"
                FontAttributes="Bold" />

            <Button
                Text="Activar notificaciones"
                Clicked="OnActivarClicked" />

            <Label
                x:Name="EstadoLabel"
                Text="Activa las notificaciones para registrar este celular."
                FontSize="14" />

   
            <BoxView
                HeightRequest="1"
                Color="Gray" />

            <!-- BLUETOOTH -->

            <Label
                Text="Conexión Bluetooth"
                FontSize="20"
                FontAttributes="Bold" />

            <Button
                x:Name="BuscarBluetoothButton"
                Text="Buscar pulsera"
                Clicked="OnBuscarBluetoothClicked" />

            <Label
                x:Name="EstadoBluetoothLabel"
                Text="Busca y conecta tu pulsera."
                FontSize="14" />

            <VerticalStackLayout
                x:Name="DispositivosLayout"
                Spacing="10" />

            <BoxView
                HeightRequest="1"
                Color="Gray" />

            <!-- CONFIGURACIÓN WI-FI -->

            <Label
                Text="Configurar Wi-Fi de la pulsera"
                FontSize="20"
                FontAttributes="Bold" />

            <Entry
                x:Name="WifiNombreEntry"
                Placeholder="Nombre de la red Wi-Fi"
                MaxLength="32" />

            <Entry
                x:Name="WifiClaveEntry"
                Placeholder="Contraseña del Wi-Fi"
                IsPassword="True" />

            <Button
                x:Name="EnviarWifiButton"
                Text="Enviar configuración Wi-Fi"
                Clicked="OnEnviarWifiClicked"
                IsEnabled="False" />

            <Label
                x:Name="EstadoWifiLabel"
                Text="Conecta primero la pulsera por Bluetooth."
                FontSize="14" />

        </VerticalStackLayout>

    </ScrollView>

</ContentPage>